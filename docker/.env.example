# ---------------------------------------------------------------------------
# docstore stack configuration (Docker Compose)
# Copy this file to `docker/.env` then fill in the values.
#   cp docker/.env.example docker/.env
# ---------------------------------------------------------------------------

# --- Public URL ------------------------------------------------------------
# Domain name served by Caddy. Leave EMPTY for plain HTTP on port HTTP_PORT
# (handy locally / on a LAN). When set, Caddy obtains and renews a Let's
# Encrypt certificate automatically (ports 80 and 443 must be reachable from
# the Internet).
DOMAIN=

# Email address passed to Let's Encrypt (optional, ignored when DOMAIN is empty).
ACME_EMAIL=

# Full public URL of the application. It is used for BETTER_AUTH_URL,
# CORS_ORIGIN and for the API URL inlined into the front-end bundle at build
# time.
# /!\ Changing it requires rebuilding the image: `bun run docker:build`.
#   - without a domain:  http://localhost   (or http://localhost:8080 if HTTP_PORT=8080)
#   - with a domain:     https://docs.exemple.fr
#   Also the base of the public links handed to third parties: /u/<token>
#   (upload) and /s/<token> (share), served by the front end.
PUBLIC_URL=http://localhost

# Ports published on the host by Caddy. Change them if 80/443 are already taken.
HTTP_PORT=80
HTTPS_PORT=443

# Maximum request body size (document upload).
MAX_UPLOAD_SIZE=100MB

# --- Database --------------------------------------------------------------
POSTGRES_DB=docstore
POSTGRES_USER=docstore
# Required. Generate a random value:
#   openssl rand -base64 24
POSTGRES_PASSWORD=change-me-postgres

# Optional override. By default the compose file builds it from the three
# POSTGRES_* values above (host `postgres` = the compose service name).
# DATABASE_URL=postgresql://docstore:<POSTGRES_PASSWORD>@postgres:5432/docstore

# --- Authentication --------------------------------------------------------
# Better Auth signing secret, 32 characters minimum. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me

# BETTER_AUTH_URL and CORS_ORIGIN are derived from PUBLIC_URL by compose,
# there is nothing to fill in here.

# --- Encryption of stored secrets ------------------------------------------
# Encryption key for mailbox passwords (and, from iteration 7 on, sensitive
# documents). 32 characters minimum. Generate:
#   openssl rand -base64 32
# /!\ Losing or changing it makes already-encrypted secrets unreadable:
#     the IMAP passwords will have to be entered again.
APP_SECRET=change-me-change-me-change-me-change-me

# --- Storage and processing ------------------------------------------------
# Root of the files, inside the named volume `docstore_data`. Do not change it
# without adapting the volume mount in docker-compose.yml.
STORAGE_PATH=/data/storage

# --- Watched folder --------------------------------------------------------
# Host folder mounted on /data/inbox in the `api` container. Files dropped
# there are ingested by a "watched folder" source configured on the path
# /data/inbox (the path as seen by the container, not by the host).
INBOX_PATH_HOST=./inbox

# --- Server configuration file ---------------------------------------------
# Host folder mounted read-only on /data/config in the `api` container. Drop a
# `docstore.json` in there to declare intake sources in the server
# configuration rather than in the database (see docker/README.md and
# docstore.config.example.json at the repository root). No file = no
# server-defined source; the /data/inbox folder above is watched anyway.
CONFIG_PATH_HOST=./config

# The `${VAR}` placeholders used by that file are resolved from this
# environment, for example the password of a declared mailbox:
# MAIL_PASSWORD=

# Enables the ingestion worker (OCR, extraction) inside the `api` container.
WORKER_ENABLED=true

# Number of ingestion jobs processed in parallel.
WORKER_CONCURRENCY=2

# --- External binaries -----------------------------------------------------
# Empty = looked up on the image PATH, where tesseract and poppler are already
# installed. Only set them to point at a custom installation.
TESSERACT_PATH=
POPPLER_PATH=
# Tesseract 5 language data on Debian (fra + eng installed in the image).
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

# --- Misc ------------------------------------------------------------------
NODE_ENV=production
TZ=Europe/Paris
