BETTER_AUTH_SECRET=change-me
# Public origin of the API and origin the browser is allowed to call it from.
# `bun run dev` overrides both with the single origin it serves (portless URL,
# or http://localhost:3001 with --no-portless); these values only apply to the
# raw split-port servers (`bun run dev:server` / `dev:web`) and to Docker.
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://postgres:password@localhost:5434/docstore
# Server and credentials of the test databases. Only the database name is
# reused: each package gets its own `docstore_test_<package>`, created on the
# fly, so `turbo run test` can run them in parallel. TEST_DB_SUFFIX overrides
# the package-derived name.
DATABASE_URL_TEST=postgresql://postgres:password@localhost:5434/docstore_test
# Encryption of stored secrets (IMAP passwords), of the files of sensitive
# documents, and signature of the share-link access tokens. 32 characters
# minimum. Generate with:
#   openssl rand -base64 32
# Rotation is NOT supported: changing it makes the already-encrypted secrets
# and files unreadable (see docs/security.md).
APP_SECRET=change-me-change-me-change-me-change-me
# Public origin of the WEB app: the base of the pages handed to third parties,
# /u/<token> (upload links) and /s/<token> (share links). Not the API origin —
# those pages call the API under /api/ on the same origin behind the proxy.
# Empty = BETTER_AUTH_URL.
PUBLIC_URL=
# External binaries (empty = looked up on the PATH)
TESSERACT_PATH=
TESSDATA_PREFIX=
POPPLER_PATH=
STORAGE_PATH=./data/storage
# Drop folder watched out of the box: when it is set and no configuration file
# declares a source on it, the server creates a managed "inbox" source that
# moves every imported file into <INBOX_PATH>/imported.
INBOX_PATH=
# Server configuration file (JSON) declaring intake sources outside the
# database. Absent file = no server-defined source. See
# docstore.config.example.json at the repository root; Docker uses
# /data/config/docstore.json.
DOCSTORE_CONFIG=./docstore.config.json
# Document processing inside the server process (false = external worker)
WORKER_ENABLED=true
