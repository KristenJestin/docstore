{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"db:push": {
			"cache": false,
			"interactive": true
		},
		"db:generate": {
			"cache": false,
			"interactive": true
		},
		"db:migrate": {
			"cache": false,
			"interactive": true
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"db:start": {
			"cache": false
		},
		"db:stop": {
			"cache": false
		},
		"db:watch": {
			"cache": false,
			"persistent": true
		},
		"db:down": {
			"cache": false
		},
		"test": {
			"cache": false,
			"inputs": ["$TURBO_DEFAULT$", ".env*"]
		},
		"test:e2e": {
			"cache": false,
			"passThroughEnv": [
				"E2E_BASE_URL",
				"E2E_RUN_ID",
				"E2E_ADMIN_API_KEY",
				"E2E_ADMIN_API_KEY_ID"
			]
		}
	}
}
